{
  "name": "user-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/user/data-access/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:user"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/user/data-access",
        "main": "libs/user/data-access/src/index.ts",
        "tsConfig": "libs/user/data-access/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p libs/user/data-access/tsconfig.json"
      }
    }
  }
}
