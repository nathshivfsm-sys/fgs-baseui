{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p libs/ui/tsconfig.json"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "storybook dev --port 6006 --config-dir .storybook"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/storybook/ui"],
      "options": {
        "command": "storybook build --config-dir .storybook --output-dir dist/storybook/ui"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --run --project storybook"
      }
    },
    "typecheck-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit --project .storybook/tsconfig.json"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
