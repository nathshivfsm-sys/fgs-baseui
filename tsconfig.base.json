{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@cms/platform-contract": ["./libs/platform-contract/src/index.ts"],
      "@cms/ui": ["./libs/ui/src/index.ts"],
      "@cms/ui/*": ["./libs/ui/src/*"],
      "@cms/shared-api": ["./libs/shared/api/src/index.ts"],
      "@cms/shared-auth": ["./libs/shared/auth/src/index.ts"],
      "@cms/workorder-data-access": [
        "./libs/workorder/data-access/src/index.ts"
      ],
      "@cms/lead-data-access": ["./libs/lead/data-access/src/index.ts"],
      "@cms/module-federation-shared": ["./tools/module-federation/shared.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
