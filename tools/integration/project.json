{
  "name": "integration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/integration/src",
  "projectType": "library",
  "tags": ["type:integration"],
  "targets": {
    "test-query": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --run --project query"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p tools/integration/tsconfig.json"
      }
    }
  }
}
