{
  "name": "customer-contract",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/customer/contract/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:customer", "type:contract"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/customer/contract",
        "main": "libs/customer/contract/src/index.ts",
        "tsConfig": "libs/customer/contract/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p libs/customer/contract/tsconfig.json"
      }
    }
  }
}
