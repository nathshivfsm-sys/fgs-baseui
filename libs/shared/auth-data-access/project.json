{
  "name": "auth-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/auth-data-access/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/auth-data-access",
        "main": "libs/shared/auth-data-access/src/index.ts",
        "tsConfig": "libs/shared/auth-data-access/tsconfig.lib.json",
        "assets": ["libs/shared/auth-data-access/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p libs/shared/auth-data-access/tsconfig.json"
      }
    }
  }
}
