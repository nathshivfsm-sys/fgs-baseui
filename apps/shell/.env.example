# LOCAL DEVELOPMENT ONLY. Copy to .env.local and fill in the values.
# .env.local is gitignored; nothing here is used by CI or any deployed environment.
#
# There is no interactive sign-in yet: the login screen exchanges the refresh token
# below for an access token via POST /auth/refresh, and the identity that comes back is
# whoever that token belongs to. See apps/shell/src/util/authenticate-with-api.ts.

# When `true`, the shell starts MSW before render and intercepts /api/v1 in the
# browser. Login and Settings keep calling the same customFetch endpoints.
# When `false` or unset, those requests go to the real API (via the proxy below).
VITE_USE_MOCK_API=false

# Prefix prepended to every customFetch endpoint.
#   Local:  /api/v1                     (relative — goes through the dev proxy below)
#   Deployed: https://<api-host>/api/v1 (absolute — that host must allow the origin)
VITE_API_URL=/api/v1

# Dev-server-only CORS workaround. When set, vite.config.ts proxies /api/v1 to this
# origin so the browser request stays same-origin. Leave it UNSET anywhere other than a
# local machine: without it no proxy is configured at all, and `vite build` output never
# contains one regardless, so it cannot reach develop or any deployment.
VITE_DEV_API_PROXY_TARGET=

# The refresh token traded for an access token at sign-in. Treat as a live credential
# when talking to the real API. Under VITE_USE_MOCK_API=true any non-empty value
# works — e.g. mock-refresh-token — because authenticateWithApi still posts it.
VITE_DEV_REFRESH_TOKEN=
