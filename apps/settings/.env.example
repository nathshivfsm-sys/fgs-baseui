# LOCAL DEVELOPMENT ONLY. Copy to .env.local.
# Used when serving Settings standalone (port 5104). The hosted login → Settings
# flow reads apps/shell/.env.local instead.

# When `true`, standalone bootstrap starts MSW before render.
VITE_USE_MOCK_API=false

# Prefix prepended to every customFetch endpoint. Must match the MSW handlers
# (`/api/v1`) when mock mode is on.
VITE_API_URL=/api/v1
